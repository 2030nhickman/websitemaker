{
  "format": "siteforge",
  "version": 1,
  "title": "Handmade Mug — Checkout",
  "lang": "en",
  "html": "<header data-sf-id=\"sf-1\" id=\"header1\"><h1>Clay &amp; Co.</h1></header>\n<div class=\"product\">\n  <canvas data-sf-id=\"sf-2\" id=\"canvas1\" width=\"220\" height=\"220\"></canvas>\n  <div>\n    <h2 data-sf-id=\"sf-3\" id=\"text1\">Handmade stoneware mug</h2>\n    <p data-sf-id=\"sf-4\" id=\"text2\">Wheel-thrown, glazed in speckled oat. 350 ml. Ships in 3 days.</p>\n    <p data-sf-id=\"sf-5\" id=\"price\" class=\"price\">€24.00</p>\n    <div data-sf-id=\"sf-6\" id=\"checkout1\" class=\"sf-stripe\" data-sf-stripe>\n      <button type=\"button\" class=\"sf-stripe-button\">Buy now</button>\n      <form class=\"sf-stripe-form\" hidden>\n        <input type=\"hidden\" name=\"price\">\n        <input type=\"hidden\" name=\"email\">\n      </form>\n    </div>\n    <button type=\"button\" data-sf-id=\"sf-7\" id=\"gift\" class=\"secondary\">Buy as a gift</button>\n  </div>\n</div>\n<p data-sf-id=\"sf-8\" id=\"status\" class=\"status\" hidden></p>\n<footer data-sf-id=\"sf-9\" id=\"footer1\"><p>Payments are processed securely by Stripe.</p></footer>\n",
  "css": "body {\n  font-family: system-ui, sans-serif;\n  margin: 0 auto;\n  max-width: 820px;\n  padding: 24px;\n  color: #1f2328;\n}\n\n.product {\n  display: flex;\n  gap: 32px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.product canvas {\n  border-radius: 16px;\n  background: #f4efe8;\n}\n\n.price {\n  font-size: 1.6em;\n  font-weight: 700;\n}\n\n.secondary {\n  margin-left: 8px;\n  padding: 12px 20px;\n  border-radius: 8px;\n  border: 1px solid #635bff;\n  background: transparent;\n  color: #635bff;\n  font: 600 16px system-ui, sans-serif;\n  cursor: pointer;\n}\n\n.status {\n  padding: 12px 16px;\n  border-radius: 8px;\n  background: #e7f7ee;\n  color: #1a7f4b;\n}\n\n/* sf:stripe — SiteForge checkout button */\n.sf-stripe-button {\n  background: #635bff;\n  color: #fff;\n  border: none;\n  border-radius: 8px;\n  padding: 12px 24px;\n  font: 600 16px system-ui, sans-serif;\n  cursor: pointer;\n}\n.sf-stripe-button:hover {\n  background: #5146e5;\n}\n.sf-stripe-button:disabled {\n  opacity: 0.6;\n  cursor: progress;\n}\n",
